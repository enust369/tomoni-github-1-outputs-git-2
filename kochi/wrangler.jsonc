{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "kochi-kanko-ranking",
  "compatibility_date": "2026-09-20",
  "main": "./worker.mjs",
  "assets": {
    "directory": "./dist",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kochi-kanko-ranking-db",
      "database_id": "6806fb7e-fbef-4347-a1b3-14d0289cafb3"
    }
  ]
}
