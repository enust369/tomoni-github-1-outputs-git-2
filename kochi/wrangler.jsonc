{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "kochi-kanko-ranking",
  "compatibility_date": "2026-09-20",
  "main": "./worker.mjs",
  "assets": {
    "directory": "./dist",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ]
}
